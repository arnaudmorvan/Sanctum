node_modules/

# Anchored at the root, ON PURPOSE: an unanchored `dist/` would also match
# vendor/ui-react/dist, that is the vendored kit — which the build requires. Without the
# anchor, a fresh clone does not build.
/dist/
# No trailing slash, on purpose: `npm run dev <slug>` places a SYMLINK to protos/<slug>/,
# and git sees a link as a file — `/src/proto/` would not have ignored it.
/src/proto
